AUTH_SECRET=replace-with-openssl-rand-base64-32
SEED_EMAIL=seed@example.com
SEED_PASSWORD=subscription-preview
DATABASE_URL=postgres://postgres:postgres@localhost:5432/subscription_records
# Server-only. Leave empty in development to use the labelled fixture extractor.
ANTHROPIC_API_KEY=
# Server-only. Transcribes voice notes; recording is unavailable without it.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Private R2 or S3 bucket for screenshot capture; server-only, never public.
# Leave empty in development to keep uploads on disk in .captures instead.
CAPTURE_STORAGE_BUCKET=
CAPTURE_STORAGE_ENDPOINT=
CAPTURE_STORAGE_REGION=auto
CAPTURE_STORAGE_ACCESS_KEY_ID=
CAPTURE_STORAGE_SECRET_ACCESS_KEY=
# Server-only. Runs the nightly lapse and reminder scans on Inngest; without keys
# they are only reachable through POST /api/jobs/lapse-scan and
# POST /api/jobs/reminder-scan.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
